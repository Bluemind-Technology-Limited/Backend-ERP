# Supabase connection strings
# Runtime — transaction pooler (port 6543), designed for serverless/auto-scaling.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI — session pooler (port 5432) for migrations/introspection (DDL).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth — JWT secret used to verify incoming tokens offline (jsonwebtoken)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Supabase URL + keys (used by the backend admin client / seed scripts)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Private Supabase Storage bucket holding QA proof-of-check attachments
# (photos, certificates, lab reports). Create it once in the Supabase dashboard.
QA_ATTACHMENTS_BUCKET="qa-attachments"

# Upstash QStash
QSTASH_URL="https://qstash-us-east-1.upstash.io"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-next-signing-key"

RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@kibgroup.com
GITHUB_WEBHOOK_SECRET=your-secret
API_BASE_URL=https://your-backend-url
# Resend Email Service
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="noreply@kib.com"

# GitHub Webhooks
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"

# Server Configuration
PORT=3002
API_BASE_URL="http://localhost:3002"
NODE_ENV="development"

# LPO PDF header / currency (used when generating supplier LPOs)
COMPANY_NAME="KIB Group"
COMPANY_ADDRESS="Lagos, Nigeria"
COMPANY_PHONE=""
COMPANY_EMAIL="procurement@kibgroup.com"
LPO_CURRENCY="NGN"

# Cloudflare R2 — QA review documents (presigned uploads from the browser)
# Create an R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="kib-qa"
R2_PUBLIC_BASE_URL="https://pub-YOUR-BUCKET-ID.r2.dev"
# Optional: override the S3 endpoint (defaults to https://<account>.r2.cloudflarestorage.com)
# R2_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# Browser origins allowed to upload directly (comma-separated; * = any)
R2_ALLOWED_ORIGINS="*"
