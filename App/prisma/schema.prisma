// KIB ERP — Prisma schema (PostgreSQL / Supabase)
// Event-driven inventory ledger, RBAC, procurement, production & QA.
// Docs: ../../architecture/KIB-ERP-target-architecture.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN // full access, manages admins & high-value approvals
  EXECUTIVE_ADMIN // dashboards, KPIs, approves high-value adjustments
  STORE_OFFICER // requisitions, GRN receiving, issues to production, transfers
  PRODUCTION_MANAGER // BOMs, production orders, machines/staff allocation
  PROCUREMENT_OFFICER // suppliers, requisition -> purchase orders
  QA_INSPECTOR // block/release batches, lab tests, GRN approval
}

enum MaterialType {
  RAW
  PACKAGING
  FINISHED
}

enum BatchStatus {
  ACTIVE
  QUARANTINE
  REJECTED
  EXPIRED
}

enum LedgerEventType {
  PO_RECEIPT // positive
  PROD_CONSUMPTION // negative
  PROD_OUTPUT // positive
  WASTE // negative
  ADJUSTMENT // +/- (gated)
  TRANSFER_IN // positive
  TRANSFER_OUT // negative
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
}

enum GoodsReceiptStatus {
  PENDING_QA
  APPROVED
  REJECTED
}

enum ProductionOrderStatus {
  SCHEDULED
  RELEASED
  PROCESSING
  COMPLETED
  WASTED
}

enum ProductionPlanStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConsignmentStatus {
  DRAFT
  READY_FOR_SHIPMENT
  IN_TRANSIT
  RECEIVED
  DISTRIBUTED
  COMPLETED
}

enum ProductionIngredientStatus {
  RESERVED
  RELEASED
  CONSUMED
  RETURNED
  PARTIALLY_CONSUMED
}

enum BomStatus {
  DRAFT
  ACTIVE
  APPROVED
  ARCHIVED
}

enum InspectionResult {
  PENDING
  PASSED
  FAILED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// 1. Auth & RBAC
// ---------------------------------------------------------------------------

model User {
  // id = Supabase Auth user id (JWT `sub`). The `users` table is the app
  // profile layer keyed 1:1 to Supabase `auth.users`. Created post-signup
  // (see seed script / auth webhook), never auto-generated here.
  id           String   @id
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole
  phoneNumber  String?  @map("phone_number")
  isActive     Boolean  @default(true) @map("is_active")
  hasSeenTour  Boolean  @default(false) @map("has_seen_tour")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  requisitions              Requisition[]
  purchaseOrders            PurchaseOrder[]
  goodsReceipts             GoodsReceipt[]
  productionOrders          ProductionOrder[]      @relation("order_creator")
  releasedIngredientsOrders ProductionOrder[]      @relation("order_ingredients_releaser")
  yieldLoggedOrders         ProductionOrder[]      @relation("yield_logger")
  releasedIngredients       ProductionIngredient[] @relation("ingredient_releaser")
  inspections               InspectionRecord[]
  createdTransactions       InventoryTransaction[] @relation("transaction_creator")
  approvedAdjustments       InventoryTransaction[] @relation("adjustment_approver")
  notifications             Notification[]
  bomApprovedBy             Bom[]                  @relation("bom_approved_by")
  bomUpdatedBy              Bom[]                  @relation("bom_updated_by")
  productionPlans           ProductionPlan[]
  consignmentsCreated       Consignment[]          @relation("consignment_creator")
  consignmentsReceived      Consignment[]          @relation("consignment_receiver")
  consignmentDistributions  ConsignmentDistribution[]

  @@map("users")
}

model RolePermission {
  id         String   @id @default(uuid())
  role       UserRole
  module     String // e.g. "inventory", "procurement", "production", "qa", "reports"
  canCreate  Boolean  @default(false) @map("can_create")
  canRead    Boolean  @default(true) @map("can_read")
  canUpdate  Boolean  @default(false) @map("can_update")
  canDelete  Boolean  @default(false) @map("can_delete")
  canApprove Boolean  @default(false) @map("can_approve")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([role, module])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// 2. Master Data
// ---------------------------------------------------------------------------

model Material {
  id                String       @id @default(uuid())
  name              String
  sku               String       @unique
  type              MaterialType
  category          String?
  unitOfMeasure     String       @map("unit_of_measure") // kg, liters, units
  barcode           String?
  defaultExpiryDate DateTime?    @map("default_expiry_date") // Default expiry (e.g., 2 years out)
  requiresLot       Boolean      @default(true) @map("requires_lot")
  minQuantity       Decimal?     @default(0) @map("min_quantity") @db.Decimal(15, 4)
  attachments       Json? // [{name, url, kind: NAFDAC|MSDS|COA}]
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  batches               BatchLot[]
  transactions          InventoryTransaction[]
  bomIngredients        BomIngredient[]
  requisitionItems      RequisitionItem[]
  poItems               PurchaseOrderItem[]
  grnItems              GoodsReceiptItem[]
  inspectionRecords     InspectionRecord[]
  suppliers             MaterialSupplier[]
  productionIngredients ProductionIngredient[]
  bomFinishedSku        Bom[]                  @relation("finished_sku")
  planAggregatedIngredients PlanAggregatedIngredient[] @relation("plan_ingredients")
  consignmentItems      ConsignmentItem[]      @relation("consignment_items")

  @@map("materials")
}

model Warehouse {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  address   String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  zones        Zone[]
  bins         WarehouseBin[]
  transactions InventoryTransaction[]
  consignments Consignment[]

  @@map("warehouses")
}

model Zone {
  id          String       @id @default(uuid())
  warehouseId String       @map("warehouse_id")
  name        String
  code        String
  status      RecordStatus @default(ACTIVE)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bins      WarehouseBin[]

  @@unique([warehouseId, code])
  @@map("zones")
}

model WarehouseBin {
  id          String       @id @default(uuid())
  zoneId      String       @map("zone_id")
  warehouseId String       @map("warehouse_id")
  name        String
  code        String
  status      RecordStatus @default(ACTIVE)

  zone         Zone                   @relation(fields: [zoneId], references: [id])
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id])
  transactions InventoryTransaction[]
  distributions ConsignmentDistribution[]

  @@unique([zoneId, code])
  @@map("warehouse_bins")
}

model Supplier {
  id            String       @id @default(uuid())
  name          String
  contactPerson String?      @map("contact_person")
  email         String?
  phone         String?
  address       String?
  taxId         String?      @map("tax_id")
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]
  materials      MaterialSupplier[]
  consignments   Consignment[]

  @@map("suppliers")
}

// Many-to-many: which suppliers can source a given material.
model MaterialSupplier {
  materialId String   @map("material_id")
  supplierId String   @map("supplier_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([materialId, supplierId])
  @@map("material_suppliers")
}

// ---------------------------------------------------------------------------
// 3. Inventory Ledger (event-sourced)
// ---------------------------------------------------------------------------

model BatchLot {
  id                String      @id @default(uuid())
  batchNumber       String      @map("batch_number")
  materialId        String      @map("material_id")
  manufacturingDate DateTime?   @map("manufacturing_date")
  expiryDate        DateTime?   @map("expiry_date")
  status            BatchStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at")

  material              Material               @relation(fields: [materialId], references: [id])
  transactions          InventoryTransaction[]
  productionOrders      ProductionOrder[]      @relation("finished_batch")
  grnItems              GoodsReceiptItem[]
  inspections           InspectionRecord[]
  productionIngredients ProductionIngredient[]

  @@unique([materialId, batchNumber])
  @@map("batch_lots")
}

// THE LEDGER — every stock movement is an immutable entry.
// "Current stock" is the SUM of transactions per material/batch/bin. Never a mutable column.
model InventoryTransaction {
  id            String          @id @default(uuid())
  eventType     LedgerEventType @map("event_type")
  materialId    String          @map("material_id")
  batchLotId    String?         @map("batch_lot_id")
  warehouseId   String          @map("warehouse_id")
  binId         String?         @map("bin_id")
  quantity      Decimal         @db.Decimal(15, 4) // signed: + in, - out
  unitOfMeasure String          @map("unit_of_measure")
  referenceType String?         @map("reference_type") // PO, GRN, PROD_ORDER, ADJUSTMENT
  referenceId   String?         @map("reference_id")
  createdById   String          @map("created_by_id")
  approvedById  String?         @map("approved_by_id") // for gated adjustments
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")

  material   Material      @relation(fields: [materialId], references: [id])
  batchLot   BatchLot?     @relation(fields: [batchLotId], references: [id])
  warehouse  Warehouse     @relation(fields: [warehouseId], references: [id])
  bin        WarehouseBin? @relation(fields: [binId], references: [id])
  createdBy  User          @relation("transaction_creator", fields: [createdById], references: [id])
  approvedBy User?         @relation("adjustment_approver", fields: [approvedById], references: [id])

  @@index([materialId, batchLotId, warehouseId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// 4. Procurement (Requisition -> PO -> GRN)
// ---------------------------------------------------------------------------

model Requisition {
  id            String            @id @default(uuid())
  number        String            @unique
  requestedById String            @map("requested_by_id")
  status        RequisitionStatus @default(DRAFT)
  notes         String?
  approvedAt    DateTime?         @map("approved_at")
  rejectedAt    DateTime?         @map("rejected_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  requestedBy    User              @relation(fields: [requestedById], references: [id])
  items          RequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@map("requisitions")
}

model RequisitionItem {
  id            String  @id @default(uuid())
  requisitionId String  @map("requisition_id")
  materialId    String  @map("material_id")
  quantity      Decimal @db.Decimal(15, 4)
  unitOfMeasure String  @map("unit_of_measure")

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  material    Material    @relation(fields: [materialId], references: [id])

  @@map("requisition_items")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  number           String              @unique
  supplierId       String              @map("supplier_id")
  requisitionId    String?             @map("requisition_id")
  createdById      String              @map("created_by_id")
  status           PurchaseOrderStatus @default(DRAFT)
  orderDate        DateTime?           @default(now()) @map("order_date")
  expectedDelivery DateTime?           @map("expected_delivery")
  sentAt           DateTime?           @map("sent_at")
  receivedAt       DateTime?           @map("received_at")
  closedAt         DateTime?           @map("closed_at")
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  requisition   Requisition?        @relation(fields: [requisitionId], references: [id])
  createdBy     User                @relation(fields: [createdById], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String  @id @default(uuid())
  poId          String  @map("po_id")
  materialId    String  @map("material_id")
  quantity      Decimal @db.Decimal(15, 4)
  unitCost      Decimal @map("unit_cost") @db.Decimal(15, 4)
  receivedQty   Decimal @default(0) @map("received_qty") @db.Decimal(15, 4)
  unitOfMeasure String  @map("unit_of_measure")

  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id           String             @id @default(uuid())
  number       String             @unique
  poId         String             @map("po_id")
  receivedById String             @map("received_by_id")
  status       GoodsReceiptStatus @default(PENDING_QA)
  receivedAt   DateTime           @default(now()) @map("received_at")
  approvedAt   DateTime?          @map("approved_at")
  rejectedAt   DateTime?          @map("rejected_at")
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  po         PurchaseOrder      @relation(fields: [poId], references: [id])
  receivedBy User               @relation(fields: [receivedById], references: [id])
  items      GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id            String  @id @default(uuid())
  grnId         String  @map("grn_id")
  materialId    String  @map("material_id")
  batchLotId    String  @map("batch_lot_id")
  quantity      Decimal @db.Decimal(15, 4)
  unitOfMeasure String  @map("unit_of_measure")

  grn      GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  material Material     @relation(fields: [materialId], references: [id])
  batchLot BatchLot     @relation(fields: [batchLotId], references: [id])

  @@map("goods_receipt_items")
}

// ---------------------------------------------------------------------------
// 5. Production Engineering & Execution
// ---------------------------------------------------------------------------

model Bom {
  id            String    @id @default(uuid())
  productName   String    @map("product_name")
  description   String?
  expectedYield Decimal?  @map("expected_yield") @db.Decimal(15, 4)
  yieldUnit     String?   @map("yield_unit")
  finishedSkuId String?   @map("finished_sku_id") // the FINISHED material produced
  status        BomStatus @default(DRAFT)
  approvedAt    DateTime? @map("approved_at")
  approvedById  String?   @map("approved_by_id")
  archivedAt    DateTime? @map("archived_at")
  updatedById   String?   @map("updated_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  finishedSku     Material?      @relation("finished_sku", fields: [finishedSkuId], references: [id])
  approvedBy      User?          @relation("bom_approved_by", fields: [approvedById], references: [id])
  updatedBy       User?          @relation("bom_updated_by", fields: [updatedById], references: [id])
  ingredients     BomIngredient[]
  productionOrders ProductionOrder[]
  planItems       ProductionPlanItem[]

  @@index([status])
  @@index([finishedSkuId])
  @@map("boms")
}

model BomIngredient {
  id            String  @id @default(uuid())
  bomId         String  @map("bom_id")
  materialId    String  @map("material_id")
  quantity      Decimal @db.Decimal(15, 4)
  unitOfMeasure String  @map("unit_of_measure")
  isPercentage  Boolean @default(false) @map("is_percentage") // % vs absolute weight

  bom      Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@index([bomId])
  @@map("bom_ingredients")
}

model Machine {
  id     String       @id @default(uuid())
  name   String
  code   String       @unique
  status RecordStatus @default(ACTIVE)

  productionOrders ProductionOrder[]

  @@map("machines")
}

model Shift {
  id        String @id @default(uuid())
  name      String
  startTime String @map("start_time")
  endTime   String @map("end_time")

  productionOrders ProductionOrder[]

  @@map("shifts")
}

model ProductionOrder {
  id                      String                @id @default(uuid())
  orderNumber             String                @unique
  bomId                   String                @map("bom_id")
  targetQuantity          Decimal               @map("target_quantity") @db.Decimal(15, 4)
  actualYield             Decimal?              @map("actual_yield") @db.Decimal(15, 4)
  errorPercentage         Decimal?              @map("error_percentage") @db.Decimal(5, 2)
  status                  ProductionOrderStatus @default(SCHEDULED)
  scheduledStart          DateTime?             @map("scheduled_start")
  actualStart             DateTime?             @map("actual_start")
  actualEnd               DateTime?             @map("actual_end")
  machineId               String?               @map("machine_id")
  shiftId                 String?               @map("shift_id")
  createdById             String                @map("created_by_id")
  finishedBatchId         String?               @map("finished_batch_id")
  mixCode                 String?               @map("mix_code")
  mixLogDate              DateTime?             @map("mix_log_date")
  mixUnits                Decimal?              @map("mix_units") @db.Decimal(15, 4)
  ingredientsReleasedAt   DateTime?             @map("ingredients_released_at")
  ingredientsReleasedById String?               @map("ingredients_released_by_id")
  yieldLoggedAt           DateTime?             @map("yield_logged_at")
  yieldLoggedById         String?               @map("yield_logged_by_id")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  bom                   Bom                @relation(fields: [bomId], references: [id])
  machine               Machine?           @relation(fields: [machineId], references: [id])
  shift                 Shift?             @relation(fields: [shiftId], references: [id])
  createdBy             User               @relation("order_creator", fields: [createdById], references: [id])
  ingredientsReleasedBy User?              @relation("order_ingredients_releaser", fields: [ingredientsReleasedById], references: [id])
  yieldLoggedBy         User?              @relation("yield_logger", fields: [yieldLoggedById], references: [id])
  finishedBatch         BatchLot?          @relation("finished_batch", fields: [finishedBatchId], references: [id])
  productionIngredients ProductionIngredient[]

  @@map("production_orders")
}

model ProductionIngredient {
  id                String                      @id @default(uuid())
  productionOrderId String                      @map("production_order_id")
  materialId        String                      @map("material_id")
  projectedQuantity Decimal                     @map("projected_quantity") @db.Decimal(15, 4)
  releasedQuantity  Decimal                     @default(0) @map("released_quantity") @db.Decimal(15, 4)
  returnedQuantity  Decimal                     @default(0) @map("returned_quantity") @db.Decimal(15, 4)
  batchLotId        String?                     @map("batch_lot_id")
  releasedAt        DateTime?                   @map("released_at")
  releasedById      String?                     @map("released_by_id")
  status            ProductionIngredientStatus  @default(RESERVED) @map("status")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  material        Material        @relation(fields: [materialId], references: [id])
  batchLot        BatchLot?       @relation(fields: [batchLotId], references: [id])
  releasedBy      User?           @relation("ingredient_releaser", fields: [releasedById], references: [id])

  @@map("production_ingredients")
}

// ---------------------------------------------------------------------------
// Production Planning (Multi-Product Plans)
// ---------------------------------------------------------------------------

model ProductionPlan {
  id           String                @id @default(uuid())
  planNumber   String                @unique
  description  String?
  status       ProductionPlanStatus  @default(DRAFT)
  scheduledFor DateTime?             @map("scheduled_for")
  startedAt    DateTime?             @map("started_at")
  completedAt  DateTime?             @map("completed_at")
  createdById  String                @map("created_by_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  createdBy        User                   @relation(fields: [createdById], references: [id])
  items            ProductionPlanItem[]
  aggregatedIngredients PlanAggregatedIngredient[]

  @@index([status])
  @@index([scheduledFor])
  @@map("production_plans")
}

model ProductionPlanItem {
  id               String  @id @default(uuid())
  productionPlanId String  @map("production_plan_id")
  bomId            String  @map("bom_id")
  targetQuantity   Decimal @map("target_quantity") @db.Decimal(15, 4)
  actualYield      Decimal? @map("actual_yield") @db.Decimal(15, 4)
  sequence         Int     @default(1) // Order in which products are produced

  productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  bom            Bom            @relation(fields: [bomId], references: [id])

  @@index([productionPlanId])
  @@index([bomId])
  @@map("production_plan_items")
}

model PlanAggregatedIngredient {
  id               String  @id @default(uuid())
  productionPlanId String  @map("production_plan_id")
  materialId       String  @map("material_id")
  totalQuantity    Decimal @map("total_quantity") @db.Decimal(15, 4)
  unitOfMeasure    String  @map("unit_of_measure")
  status           String  @default("PENDING") // PENDING, RELEASED, COMPLETED

  productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  material       Material       @relation("plan_ingredients", fields: [materialId], references: [id])

  @@index([productionPlanId])
  @@index([materialId])
  @@map("plan_aggregated_ingredients")
}

// ---------------------------------------------------------------------------
// Consignment System (Warehouse Stocking via Grouped Shipments)
// ---------------------------------------------------------------------------

model Consignment {
  id              String              @id @default(uuid())
  consignmentNumber String            @unique
  supplierId      String              @map("supplier_id")
  warehouseId     String              @map("warehouse_id")
  status          ConsignmentStatus   @default(DRAFT)
  poNumbers       String?             @map("po_numbers") // CSV of related PO numbers
  shipDate        DateTime?           @map("ship_date")
  expectedDelivery DateTime?          @map("expected_delivery")
  receivedAt      DateTime?           @map("received_at")
  distributedAt   DateTime?           @map("distributed_at")
  createdById     String              @map("created_by_id")
  receivedById    String?             @map("received_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  warehouse          Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy          User                @relation("consignment_creator", fields: [createdById], references: [id])
  receivedBy         User?               @relation("consignment_receiver", fields: [receivedById], references: [id])
  items              ConsignmentItem[]
  distributions      ConsignmentDistribution[]

  @@index([status])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([shipDate])
  @@map("consignments")
}

model ConsignmentItem {
  id              String  @id @default(uuid())
  consignmentId   String  @map("consignment_id")
  materialId      String  @map("material_id")
  quantity        Decimal @db.Decimal(15, 4)
  unitOfMeasure   String  @map("unit_of_measure")
  distributedQty  Decimal @default(0) @map("distributed_qty") @db.Decimal(15, 4)

  consignment    Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  material       Material    @relation("consignment_items", fields: [materialId], references: [id])
  distributions  ConsignmentDistribution[]

  @@index([consignmentId])
  @@index([materialId])
  @@map("consignment_items")
}

model ConsignmentDistribution {
  id                String    @id @default(uuid())
  consignmentId     String    @map("consignment_id")
  consignmentItemId String    @map("consignment_item_id")
  binId             String    @map("bin_id")
  quantity          Decimal   @db.Decimal(15, 4)
  distributedAt     DateTime  @map("distributed_at") @default(now())
  distributedById   String    @map("distributed_by_id")

  consignment        Consignment        @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  consignmentItem    ConsignmentItem    @relation(fields: [consignmentItemId], references: [id], onDelete: Cascade)
  bin                WarehouseBin       @relation(fields: [binId], references: [id])
  distributedBy      User               @relation(fields: [distributedById], references: [id])

  @@index([consignmentId])
  @@index([consignmentItemId])
  @@index([binId])
  @@map("consignment_distributions")
}

// ---------------------------------------------------------------------------
// 6. QA
// ---------------------------------------------------------------------------

model InspectionRecord {
  id             String           @id @default(uuid())
  inspectionType String           @map("inspection_type") // GRN | FINISHED_BATCH
  materialId     String           @map("material_id")
  batchLotId     String?          @map("batch_lot_id")
  referenceId    String?          @map("reference_id") // GRN or Production Order
  result         InspectionResult @default(PENDING)
  notes          String?
  inspectedById  String?          @map("inspected_by_id")
  inspectedAt    DateTime?        @map("inspected_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  material  Material  @relation(fields: [materialId], references: [id])
  batchLot  BatchLot? @relation(fields: [batchLotId], references: [id])
  inspector User?     @relation(fields: [inspectedById], references: [id])

  @@map("inspection_records")
}

// ---------------------------------------------------------------------------
// 7. Notifications / Alerts
// ---------------------------------------------------------------------------

model Notification {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  title             String
  body              String?
  type              String // EXPIRY | LOW_STOCK | APPROVAL | SYSTEM
  notificationType  String   @default("SYSTEM") @map("notification_type") // LOW_STOCK_ALERT, APPROVAL_PENDING, SYSTEM, EXPIRY
  referenceId       String?  @map("reference_id") // Material ID for low-stock alerts, GRN ID for approvals, etc.
  isRead            Boolean  @default(false) @map("is_read")
  isActionable      Boolean  @default(false) @map("is_actionable") // True if user can take action (e.g., create requisition)
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, notificationType, isRead])
  @@index([createdAt])
  @@map("notifications")
}
