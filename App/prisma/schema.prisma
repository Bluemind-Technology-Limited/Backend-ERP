// KIB ERP — Prisma schema (PostgreSQL / Supabase)
// Event-driven inventory ledger, RBAC, procurement, production & QA.
// Docs: ../../architecture/KIB-ERP-target-architecture.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN // full access, manages admins & high-value approvals
  EXECUTIVE_ADMIN // dashboards, KPIs, approves high-value adjustments
  STORE_OFFICER // requisitions, GRN receiving, issues to production, transfers
  PRODUCTION_MANAGER // BOMs, production orders, machines/staff allocation
  PRODUCTION_SUPERVISOR // views plans, allocates batches to machines, reconciles daily output
  GRINDING_SUPERVISOR // runs the grinding station: batch throughput, actual output, input remainders
  PROCUREMENT_OFFICER // suppliers, requisition -> purchase orders
  QC // quality checks on consignments/batches, proposes quantity changes
  HEAD_OF_QC // approves QC quantity changes, owns the QA report
  OPERATOR // operates machines, logs breakdowns, records performance
  TECHNICIAN // maintains machines, manages spare parts, resolves breakdowns
}

enum MaterialType {
  RAW
  PACKAGING
  FINISHED
}

enum BatchStatus {
  ACTIVE
  QUARANTINE
  REJECTED
  EXPIRED
}

enum LedgerEventType {
  PO_RECEIPT // positive
  PROD_CONSUMPTION // negative
  PROD_OUTPUT // positive
  WASTE // negative
  ADJUSTMENT // +/- (gated)
  TRANSFER_IN // positive
  TRANSFER_OUT // negative
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
}

enum GoodsReceiptStatus {
  PENDING_QA
  APPROVED
  REJECTED
}

enum ProductionOrderStatus {
  SCHEDULED
  RELEASED
  PROCESSING
  COMPLETED
  WASTED
}

enum ProductionPlanStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionStage {
  GRINDING
  FINISHING
}

enum ProductionStageStatus {
  SUBMITTED
  VERIFIED
  FLAGGED
}

enum ConsignmentStatus {
  DRAFT
  READY_FOR_SHIPMENT
  IN_TRANSIT
  RECEIVED
  QUALITY_PENDING
  QUALITY_APPROVED
  DISTRIBUTED
  COMPLETED
}

enum QualityApprovalStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  APPROVED
  REJECTED
}

enum QualityCheckType {
  PHYSICAL_INSPECTION
  QUANTITY_VERIFICATION
  EXPIRY_CHECK
  PACKAGING_INSPECTION
  DOCUMENTATION_REVIEW
  LABORATORY_TEST
}

enum CostChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuantityAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  PREDICTIVE
  EMERGENCY
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionIngredientStatus {
  RESERVED
  RELEASED
  CONSUMED
  RETURNED
  PARTIALLY_CONSUMED
}

enum BomStatus {
  DRAFT
  ACTIVE
  APPROVED
  ARCHIVED
}

enum InspectionResult {
  PENDING
  PASSED
  FAILED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// 1. Auth & RBAC
// ---------------------------------------------------------------------------

model User {
  // id = Supabase Auth user id (JWT `sub`). The `users` table is the app
  // profile layer keyed 1:1 to Supabase `auth.users`. Created post-signup
  // (see seed script / auth webhook), never auto-generated here.
  id           String   @id
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole
  phoneNumber  String?  @map("phone_number")
  isActive     Boolean  @default(true) @map("is_active")
  hasSeenTour  Boolean  @default(false) @map("has_seen_tour")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  requisitions              Requisition[]
  purchaseOrders            PurchaseOrder[]
  goodsReceipts             GoodsReceipt[]
  productionOrders          ProductionOrder[]      @relation("order_creator")
  releasedIngredientsOrders ProductionOrder[]      @relation("order_ingredients_releaser")
  yieldLoggedOrders         ProductionOrder[]      @relation("yield_logger")
  releasedIngredients       ProductionIngredient[] @relation("ingredient_releaser")
  inspections               InspectionRecord[]
  createdTransactions       InventoryTransaction[] @relation("transaction_creator")
  approvedAdjustments       InventoryTransaction[] @relation("adjustment_approver")
  notifications             Notification[]
  bomApprovedBy             Bom[]                  @relation("bom_approved_by")
  bomUpdatedBy              Bom[]                  @relation("bom_updated_by")
  productionPlans           ProductionPlan[]
  consignmentsCreated       Consignment[]          @relation("consignment_creator")
  consignmentsReceived      Consignment[]          @relation("consignment_receiver")
  consignmentDistributions  ConsignmentDistribution[]
  userActivities            UserActivity[]
  batchMachineAllocations   BatchMachineAllocation[]
  reconciliations           DailyProductionReconciliation[]
  qualityApprovalsStarted   QualityApproval[]      @relation("quality_approval_started")
  qualityApprovalsApproved  QualityApproval[]      @relation("quality_approval_approved")
  qualityCheckItems         QualityCheckItem[]     @relation("quality_check_performed")
  qualityCheckAttachments   QualityCheckAttachment[]
  quantityAdjustmentsRequested QuantityAdjustment[] @relation("qty_adj_requested")
  quantityAdjustmentsApproved  QuantityAdjustment[] @relation("qty_adj_approved")
  machineCommissionings     Commissioning[]        @relation("machine_commissioned_by")
  staffAssignments          StaffAssignment[]
  costAuditsCreated         CostAudit[]            @relation("cost_changed_by")
  costAuditsApproved        CostAudit[]            @relation("cost_approved_by")

  @@map("users")
}

model RolePermission {
  id         String   @id @default(uuid())
  role       UserRole
  module     String // e.g. "inventory", "procurement", "production", "qa", "reports"
  canCreate  Boolean  @default(false) @map("can_create")
  canRead    Boolean  @default(true) @map("can_read")
  canUpdate  Boolean  @default(false) @map("can_update")
  canDelete  Boolean  @default(false) @map("can_delete")
  canApprove Boolean  @default(false) @map("can_approve")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([role, module])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// 2. Master Data
// ---------------------------------------------------------------------------

model Material {
  id                String       @id @default(uuid())
  name              String
  sku               String       @unique
  type              MaterialType
  category          String?
  unitOfMeasure     String       @map("unit_of_measure") // kg, liters, units
  barcode           String?
  defaultExpiryDate DateTime?    @map("default_expiry_date") // Default expiry (e.g., 2 years out)
  requiresLot       Boolean      @default(true) @map("requires_lot")
  minQuantity       Decimal?     @default(0) @map("min_quantity") @db.Decimal(15, 4)
  standardCost      Decimal?     @default(0) @map("standard_cost") @db.Decimal(15, 4)
  lastCostUpdateAt  DateTime?    @map("last_cost_update_at")
  lastCostUpdatedBy String?      @map("last_cost_updated_by")
  attachments       Json? // [{name, url, kind: NAFDAC|MSDS|COA}]
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  batches               BatchLot[]
  transactions          InventoryTransaction[]
  bomIngredients        BomIngredient[]
  requisitionItems      RequisitionItem[]
  poItems               PurchaseOrderItem[]
  grnItems              GoodsReceiptItem[]
  inspectionRecords     InspectionRecord[]
  suppliers             MaterialSupplier[]
  productionIngredients ProductionIngredient[]
  bomFinishedSku        Bom[]                  @relation("finished_sku")
  planAggregatedIngredients PlanAggregatedIngredient[] @relation("plan_ingredients")
  consignmentItems      ConsignmentItem[]      @relation("consignment_items")
  quantityAdjustments   QuantityAdjustment[]
  grindingInputs        ProductionGrindingInput[]

  @@map("materials")
}

model Warehouse {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  address   String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  zones        Zone[]
  bins         WarehouseBin[]
  transactions InventoryTransaction[]
  consignments Consignment[]

  @@map("warehouses")
}

model Zone {
  id          String       @id @default(uuid())
  warehouseId String       @map("warehouse_id")
  name        String
  code        String
  status      RecordStatus @default(ACTIVE)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bins      WarehouseBin[]

  @@unique([warehouseId, code])
  @@map("zones")
}

model WarehouseBin {
  id          String       @id @default(uuid())
  zoneId      String       @map("zone_id")
  warehouseId String       @map("warehouse_id")
  name        String
  code        String
  status      RecordStatus @default(ACTIVE)

  zone         Zone                   @relation(fields: [zoneId], references: [id])
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id])
  transactions InventoryTransaction[]
  distributions ConsignmentDistribution[]

  @@unique([zoneId, code])
  @@map("warehouse_bins")
}

model Supplier {
  id            String       @id @default(uuid())
  name          String
  contactPerson String?      @map("contact_person")
  email         String?
  phone         String?
  address       String?
  taxId         String?      @map("tax_id")
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]
  materials      MaterialSupplier[]
  consignments   Consignment[]

  @@map("suppliers")
}

// Many-to-many: which suppliers can source a given material.
model MaterialSupplier {
  materialId String   @map("material_id")
  supplierId String   @map("supplier_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([materialId, supplierId])
  @@map("material_suppliers")
}

// ---------------------------------------------------------------------------
// 3. Inventory Ledger (event-sourced)
// ---------------------------------------------------------------------------

model BatchLot {
  id                String      @id @default(uuid())
  batchNumber       String      @map("batch_number")
  materialId        String      @map("material_id")
  manufacturingDate DateTime?   @map("manufacturing_date")
  expiryDate        DateTime?   @map("expiry_date")
  status            BatchStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at")

  material              Material               @relation(fields: [materialId], references: [id])
  transactions          InventoryTransaction[]
  productionOrders      ProductionOrder[]      @relation("finished_batch")
  grnItems              GoodsReceiptItem[]
  inspections           InspectionRecord[]
  productionIngredients ProductionIngredient[]
  grindingInputs        ProductionGrindingInput[]

  @@unique([materialId, batchNumber])
  @@map("batch_lots")
}

// THE LEDGER — every stock movement is an immutable entry.
// "Current stock" is the SUM of transactions per material/batch/bin. Never a mutable column.
model InventoryTransaction {
  id            String          @id @default(uuid())
  eventType     LedgerEventType @map("event_type")
  materialId    String          @map("material_id")
  batchLotId    String?         @map("batch_lot_id")
  warehouseId   String          @map("warehouse_id")
  binId         String?         @map("bin_id")
  consignmentItemId String?     @map("consignment_item_id") // links consignment stock to its ingredient
  quantity      Decimal         @db.Decimal(15, 4) // signed: + in, - out
  unitOfMeasure String          @map("unit_of_measure")
  referenceType String?         @map("reference_type") // PO, GRN, PROD_ORDER, ADJUSTMENT
  referenceId   String?         @map("reference_id")
  createdById   String          @map("created_by_id")
  approvedById  String?         @map("approved_by_id") // for gated adjustments
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")

  material   Material      @relation(fields: [materialId], references: [id])
  batchLot   BatchLot?     @relation(fields: [batchLotId], references: [id])
  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id])
  bin        WarehouseBin?   @relation(fields: [binId], references: [id])
  consignmentItem ConsignmentItem? @relation(fields: [consignmentItemId], references: [id], onDelete: SetNull)
  createdBy  User          @relation("transaction_creator", fields: [createdById], references: [id])
  approvedBy User?         @relation("adjustment_approver", fields: [approvedById], references: [id])

  @@index([materialId, batchLotId, warehouseId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// 4. Procurement (Requisition -> PO -> GRN)
// ---------------------------------------------------------------------------

model Requisition {
  id            String            @id @default(uuid())
  number        String            @unique
  requestedById String            @map("requested_by_id")
  status        RequisitionStatus @default(DRAFT)
  notes         String?
  approvedAt    DateTime?         @map("approved_at")
  rejectedAt    DateTime?         @map("rejected_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  requestedBy    User              @relation(fields: [requestedById], references: [id])
  items          RequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@map("requisitions")
}

model RequisitionItem {
  id            String  @id @default(uuid())
  requisitionId String  @map("requisition_id")
  materialId    String  @map("material_id")
  quantity      Decimal @db.Decimal(15, 4)
  unitOfMeasure String  @map("unit_of_measure")

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  material    Material    @relation(fields: [materialId], references: [id])

  @@map("requisition_items")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  number           String              @unique
  supplierId       String              @map("supplier_id")
  requisitionId    String?             @map("requisition_id")
  createdById      String              @map("created_by_id")
  status           PurchaseOrderStatus @default(DRAFT)
  orderDate        DateTime?           @default(now()) @map("order_date")
  expectedDelivery DateTime?           @map("expected_delivery")
  sentAt           DateTime?           @map("sent_at")
  receivedAt       DateTime?           @map("received_at")
  closedAt         DateTime?           @map("closed_at")
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  requisition   Requisition?        @relation(fields: [requisitionId], references: [id])
  createdBy     User                @relation(fields: [createdById], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String  @id @default(uuid())
  poId          String  @map("po_id")
  materialId    String  @map("material_id")
  quantity      Decimal @db.Decimal(15, 4)
  unitCost      Decimal @map("unit_cost") @db.Decimal(15, 4)
  receivedQty   Decimal @default(0) @map("received_qty") @db.Decimal(15, 4)
  unitOfMeasure String  @map("unit_of_measure")

  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id           String             @id @default(uuid())
  number       String             @unique
  poId         String?            @map("po_id")
  consignmentId String?           @map("consignment_id")
  receivedById String             @map("received_by_id")
  status       GoodsReceiptStatus @default(PENDING_QA)
  receivedAt   DateTime           @default(now()) @map("received_at")
  approvedAt   DateTime?          @map("approved_at")
  rejectedAt   DateTime?          @map("rejected_at")
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  po         PurchaseOrder?     @relation(fields: [poId], references: [id])
  consignment Consignment?       @relation(fields: [consignmentId], references: [id])
  receivedBy User               @relation(fields: [receivedById], references: [id])
  items      GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id            String  @id @default(uuid())
  grnId         String  @map("grn_id")
  materialId    String  @map("material_id")
  batchLotId    String  @map("batch_lot_id")
  quantity      Decimal @db.Decimal(15, 4)
  unitOfMeasure String  @map("unit_of_measure")
  unitCost      Decimal @default(0) @map("unit_cost") @db.Decimal(15, 4)

  grn      GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  material Material     @relation(fields: [materialId], references: [id])
  batchLot BatchLot     @relation(fields: [batchLotId], references: [id])

  @@map("goods_receipt_items")
}

// ---------------------------------------------------------------------------
// 5. Production Engineering & Execution
// ---------------------------------------------------------------------------

model Bom {
  id            String    @id @default(uuid())
  productName   String    @map("product_name")
  description   String?
  expectedYield Decimal?  @map("expected_yield") @db.Decimal(15, 4)
  yieldUnit     String?   @map("yield_unit")
  finishedSkuId String?   @map("finished_sku_id") // the FINISHED material produced
  status        BomStatus @default(DRAFT)
  approvedAt    DateTime? @map("approved_at")
  approvedById  String?   @map("approved_by_id")
  archivedAt    DateTime? @map("archived_at")
  updatedById   String?   @map("updated_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  finishedSku     Material?      @relation("finished_sku", fields: [finishedSkuId], references: [id])
  approvedBy      User?          @relation("bom_approved_by", fields: [approvedById], references: [id])
  updatedBy       User?          @relation("bom_updated_by", fields: [updatedById], references: [id])
  ingredients     BomIngredient[]
  productionOrders ProductionOrder[]
  planItems       ProductionPlanItem[]

  @@index([status])
  @@index([finishedSkuId])
  @@map("boms")
}

model BomIngredient {
  id            String  @id @default(uuid())
  bomId         String  @map("bom_id")
  materialId    String  @map("material_id")
  quantity      Decimal @db.Decimal(15, 4)
  unitOfMeasure String  @map("unit_of_measure")
  isPercentage  Boolean @default(false) @map("is_percentage") // % vs absolute weight
  estimatedCost Decimal @default(0) @map("estimated_cost") @db.Decimal(15, 4)
  costUpdatedAt DateTime? @map("cost_updated_at")

  bom      Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@index([bomId])
  @@map("bom_ingredients")
}

// ---------------------------------------------------------------------------
// Machines Module - Clean Rebuild
// ---------------------------------------------------------------------------

model MachineCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  machines Machine[]

  @@map("machine_categories")
}

model MachineDepartment {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  machines Machine[]

  @@map("machine_departments")
}

model MachineLocation {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  machines Machine[]

  @@map("machine_locations")
}

model Machine {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  serialNumber     String   @unique @map("serial_number")
  categoryId       String   @map("category_id")
  departmentId     String   @map("department_id")
  locationId       String?  @map("location_id")
  status           String   @default("ACTIVE") // ACTIVE, IDLE, UNDER_MAINTENANCE, OUT_OF_SERVICE
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category    MachineCategory   @relation(fields: [categoryId], references: [id])
  department  MachineDepartment @relation(fields: [departmentId], references: [id])
  location    MachineLocation?  @relation(fields: [locationId], references: [id])

  spareParts       SparePart[]
  maintenances     Maintenance[]
  commissionings   Commissioning[]
  performances     Performance[]
  staffAssignments StaffAssignment[]

  @@index([status])
  @@index([categoryId])
  @@index([departmentId])
  @@index([locationId])
  @@map("machines")
}

model Shift {
  id        String @id @default(uuid())
  name      String
  startTime String @map("start_time")
  endTime   String @map("end_time")

  productionOrders ProductionOrder[]

  @@map("shifts")
}

// ---------------------------------------------------------------------------
// Machine asset management (spare parts, maintenance, commissioning,
// performance, staff assignment).
// ---------------------------------------------------------------------------

model SparePart {
  id              String    @id @default(uuid())
  machineId       String    @map("machine_id")
  partName        String    @map("part_name")
  partNumber      String    @map("part_number")
  description     String?
  supplier        String?
  stockLevel      Int       @default(0) @map("stock_level")
  minStockLevel   Int       @default(0) @map("min_stock_level")
  costPerUnit     Decimal   @default(0) @map("cost_per_unit") @db.Decimal(15, 2)
  lastRestockDate DateTime? @map("last_restock_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@map("spare_parts")
}

model Maintenance {
  id                  String            @id @default(uuid())
  machineId           String            @map("machine_id")
  type                MaintenanceType
  status              MaintenanceStatus @default(SCHEDULED)
  scheduledDate       DateTime          @map("scheduled_date")
  completedDate       DateTime?         @map("completed_date")
  description         String?
  techniciansAssigned String?           @map("technicians_assigned")
  estimatedDuration   Int?              @map("estimated_duration")
  actualDuration      Int?              @map("actual_duration")
  costEstimate        Decimal?          @map("cost_estimate") @db.Decimal(15, 2)
  actualCost          Decimal?          @map("actual_cost") @db.Decimal(15, 2)
  notes               String?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, scheduledDate])
  @@index([status])
  @@map("maintenances")
}

model Commissioning {
  id                 String   @id @default(uuid())
  machineId          String   @map("machine_id")
  commissionedById   String   @map("commissioned_by_id")
  commissioningDate  DateTime @map("commissioning_date")
  installationStatus String   @map("installation_status")
  testResults        String?  @map("test_results")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  machine       Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  commissionedBy User   @relation("machine_commissioned_by", fields: [commissionedById], references: [id])

  @@index([machineId, commissioningDate])
  @@map("commissionings")
}

model Performance {
  id                   String   @id @default(uuid())
  machineId            String   @map("machine_id")
  recordDate           DateTime @map("record_date")
  targetOutput         Decimal  @map("target_output") @db.Decimal(15, 4)
  actualOutput         Decimal  @map("actual_output") @db.Decimal(15, 4)
  efficiencyPercentage Decimal  @default(0) @map("efficiency_percentage") @db.Decimal(6, 2)
  downtime             Int      @default(0)
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, recordDate])
  @@map("performances")
}

model StaffAssignment {
  id             String    @id @default(uuid())
  machineId      String    @map("machine_id")
  userId         String    @map("user_id")
  role           String
  assignedDate   DateTime  @default(now()) @map("assigned_date")
  unassignedDate DateTime? @map("unassigned_date")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([machineId, isActive])
  @@index([userId, isActive])
  @@map("staff_assignments")
}

model ProductionOrder {
  id                      String                @id @default(uuid())
  orderNumber             String                @unique
  bomId                   String                @map("bom_id")
  targetQuantity          Decimal               @map("target_quantity") @db.Decimal(15, 4)
  actualYield             Decimal?              @map("actual_yield") @db.Decimal(15, 4)
  errorPercentage         Decimal?              @map("error_percentage") @db.Decimal(5, 2)
  status                  ProductionOrderStatus @default(SCHEDULED)
  scheduledStart          DateTime?             @map("scheduled_start")
  actualStart             DateTime?             @map("actual_start")
  actualEnd               DateTime?             @map("actual_end")
  machineId               String?               @map("machine_id")
  shiftId                 String?               @map("shift_id")
  createdById             String                @map("created_by_id")
  finishedBatchId         String?               @map("finished_batch_id")
  mixCode                 String?               @map("mix_code")
  mixLogDate              DateTime?             @map("mix_log_date")
  mixUnits                Decimal?              @map("mix_units") @db.Decimal(15, 4)
  ingredientsReleasedAt   DateTime?             @map("ingredients_released_at")
  ingredientsReleasedById String?               @map("ingredients_released_by_id")
  yieldLoggedAt           DateTime?             @map("yield_logged_at")
  yieldLoggedById         String?               @map("yield_logged_by_id")
  estimatedCost           Decimal?              @default(0) @map("estimated_cost") @db.Decimal(15, 4)
  actualCost              Decimal?              @map("actual_cost") @db.Decimal(15, 4)
  costVariance            Decimal?              @map("cost_variance") @db.Decimal(15, 4)
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  bom                      Bom                    @relation(fields: [bomId], references: [id])
  shift                    Shift?                 @relation(fields: [shiftId], references: [id])
  createdBy                User                   @relation("order_creator", fields: [createdById], references: [id])
  ingredientsReleasedBy    User?                  @relation("order_ingredients_releaser", fields: [ingredientsReleasedById], references: [id])
  yieldLoggedBy            User?                  @relation("yield_logger", fields: [yieldLoggedById], references: [id])
  finishedBatch            BatchLot?              @relation("finished_batch", fields: [finishedBatchId], references: [id])
  productionIngredients    ProductionIngredient[]
  batchMachineAllocations  BatchMachineAllocation[]

  @@map("production_orders")
}

model ProductionIngredient {
  id                String                      @id @default(uuid())
  productionOrderId String                      @map("production_order_id")
  materialId        String                      @map("material_id")
  projectedQuantity Decimal                     @map("projected_quantity") @db.Decimal(15, 4)
  releasedQuantity  Decimal                     @default(0) @map("released_quantity") @db.Decimal(15, 4)
  returnedQuantity  Decimal                     @default(0) @map("returned_quantity") @db.Decimal(15, 4)
  batchLotId        String?                     @map("batch_lot_id")
  releasedAt        DateTime?                   @map("released_at")
  releasedById      String?                     @map("released_by_id")
  status            ProductionIngredientStatus  @default(RESERVED) @map("status")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  material        Material        @relation(fields: [materialId], references: [id])
  batchLot        BatchLot?       @relation(fields: [batchLotId], references: [id])
  releasedBy      User?           @relation("ingredient_releaser", fields: [releasedById], references: [id])

  @@map("production_ingredients")
}

// ---------------------------------------------------------------------------
// Production Planning (Multi-Product Plans)
// ---------------------------------------------------------------------------

model ProductionPlan {
  id           String                @id @default(uuid())
  planNumber   String                @unique @map("plan_number")
  description  String?
  status       ProductionPlanStatus  @default(DRAFT)
  scheduledFor DateTime?             @map("scheduled_for")
  startedAt    DateTime?             @map("started_at")
  completedAt  DateTime?             @map("completed_at")
  createdById  String                @map("created_by_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  createdBy                 User                          @relation(fields: [createdById], references: [id])
  items                     ProductionPlanItem[]
  aggregatedIngredients     PlanAggregatedIngredient[]
  stageRecords              ProductionStageRecord[]
  reconciliations           DailyProductionReconciliation[]

  @@index([status])
  @@index([scheduledFor])
  @@map("production_plans")
}

model ProductionPlanItem {
  id               String  @id @default(uuid())
  productionPlanId String  @map("production_plan_id")
  bomId            String  @map("bom_id")
  targetQuantity   Decimal @map("target_quantity") @db.Decimal(15, 4)
  actualYield      Decimal? @map("actual_yield") @db.Decimal(15, 4)
  sequence         Int     @default(1) // Order in which products are produced

  productionPlan           ProductionPlan        @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  bom                      Bom                   @relation(fields: [bomId], references: [id])
  batchMachineAllocations  BatchMachineAllocation[]
  stageRecords             ProductionStageRecord[]

  @@index([productionPlanId])
  @@index([bomId])
  @@map("production_plan_items")
}

model PlanAggregatedIngredient {
  id               String  @id @default(uuid())
  productionPlanId String  @map("production_plan_id")
  materialId       String  @map("material_id")
  totalQuantity    Decimal @map("total_quantity") @db.Decimal(15, 4)
  unitOfMeasure    String  @map("unit_of_measure")
  status           String  @default("PENDING") // PENDING, RELEASED, COMPLETED

  // Stock Manager issuance (station 1). Scalar ids keep this model decoupled.
  issuedQuantity    Decimal?  @map("issued_quantity") @db.Decimal(15, 4)
  issuedWarehouseId String?   @map("issued_warehouse_id")
  issuedBatchLotId  String?   @map("issued_batch_lot_id")
  issuedAt          DateTime? @map("issued_at")
  issuedById        String?   @map("issued_by_id")
  returnedQuantity  Decimal   @default(0) @map("returned_quantity") @db.Decimal(15, 4)

  productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  material       Material       @relation("plan_ingredients", fields: [materialId], references: [id])

  @@index([productionPlanId])
  @@index([materialId])
  @@map("plan_aggregated_ingredients")
}

/// A station's daily result for one plan item: grinding throughput (station 2)
/// or finished-goods output (station 3). Remainders are captured per material in
/// `ProductionStageRemainder` so unused raw material can be returned to stock.
model ProductionStageRecord {
  id                    String                @id @default(uuid())
  productionPlanId      String                @map("production_plan_id")
  planItemId            String                @map("plan_item_id")
  stage                 ProductionStage
  inputQuantity         Decimal               @map("input_quantity") @db.Decimal(15, 4)
  achievedQuantity      Decimal               @map("achieved_quantity") @db.Decimal(15, 4)
  remainderQuantity     Decimal               @default(0) @map("remainder_quantity") @db.Decimal(15, 4)
  carryoverUsedQuantity Decimal               @default(0) @map("carryover_used_quantity") @db.Decimal(15, 4)
  unitOfMeasure         String                @map("unit_of_measure")
  batchNumber           String?               @map("batch_number")
  machineId             String?               @map("machine_id")
  warehouseId           String?               @map("warehouse_id")
  finishedBatchLotId    String?               @map("finished_batch_lot_id")
  returnedTransactionId String?               @map("returned_transaction_id")
  productionDate        DateTime              @map("production_date")
  status                ProductionStageStatus @default(SUBMITTED)
  remarks               String?
  recordedById          String                @map("recorded_by_id")
  recordedAt            DateTime              @default(now()) @map("recorded_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  productionPlan ProductionPlan             @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  planItem       ProductionPlanItem         @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  remainders     ProductionStageRemainder[]
  grindingInputs ProductionGrindingInput[]

  @@index([productionPlanId, stage])
  @@index([planItemId, stage])
  @@index([productionDate])
  @@map("production_stage_records")
}

/// Unused material handed back from a station (per ingredient), returned to stock.
model ProductionStageRemainder {
  id                 String   @id @default(uuid())
  stageRecordId      String   @map("stage_record_id")
  materialId         String   @map("material_id")
  quantity           Decimal  @db.Decimal(15, 4)
  unitOfMeasure      String   @map("unit_of_measure")
  warehouseId        String?  @map("warehouse_id")
  batchLotId         String?  @map("batch_lot_id")
  inventoryTransactionId String? @map("inventory_transaction_id")
  createdAt          DateTime @default(now()) @map("created_at")

  stageRecord ProductionStageRecord @relation(fields: [stageRecordId], references: [id], onDelete: Cascade)

  @@index([stageRecordId])
  @@index([materialId])
  @@map("production_stage_remainders")
}

/// The exact batch lots a grinding station consumed for a batch. This is what
/// makes a plan-produced finished batch traceable to *specific* raw batches
/// (rather than just "whatever was issued to the plan").
model ProductionGrindingInput {
  id            String   @id @default(uuid())
  stageRecordId String   @map("stage_record_id")
  materialId    String   @map("material_id")
  batchLotId    String?  @map("batch_lot_id")
  quantity      Decimal  @db.Decimal(15, 4)
  unitOfMeasure String   @map("unit_of_measure")
  createdAt     DateTime @default(now()) @map("created_at")

  stageRecord ProductionStageRecord @relation(fields: [stageRecordId], references: [id], onDelete: Cascade)
  material    Material             @relation(fields: [materialId], references: [id])
  batchLot    BatchLot?            @relation(fields: [batchLotId], references: [id])

  @@index([stageRecordId])
  @@index([materialId])
  @@index([batchLotId])
  @@map("production_grinding_inputs")
}

// ---------------------------------------------------------------------------
// Consignment System (Warehouse Stocking via Grouped Shipments)
// ---------------------------------------------------------------------------

model Consignment {
  id              String              @id @default(uuid())
  consignmentNumber String            @unique @map("consignment_number")
  supplierId      String              @map("supplier_id")
  warehouseId     String              @map("warehouse_id")
  status          ConsignmentStatus   @default(DRAFT)
  poNumbers       String?             @map("po_numbers") // CSV of related PO numbers
  shipDate        DateTime?           @map("ship_date")
  expectedDelivery DateTime?          @map("expected_delivery")
  receivedAt      DateTime?           @map("received_at")
  distributedAt   DateTime?           @map("distributed_at")
  createdById     String              @map("created_by_id")
  receivedById    String?             @map("received_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  warehouse          Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy          User                @relation("consignment_creator", fields: [createdById], references: [id])
  receivedBy         User?               @relation("consignment_receiver", fields: [receivedById], references: [id])
  items               ConsignmentItem[]
  distributions       ConsignmentDistribution[]
  qualityApproval     QualityApproval?
  qualityAttachments  QualityCheckAttachment[]
  quantityAdjustments QuantityAdjustment[]
  goodsReceipts       GoodsReceipt[]

  @@index([status])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([shipDate])
  @@map("consignments")
}

model ConsignmentItem {
  id              String  @id @default(uuid())
  consignmentId   String  @map("consignment_id")
  materialId      String  @map("material_id")
  quantity        Decimal @db.Decimal(15, 4)
  unitOfMeasure   String  @map("unit_of_measure")
  distributedQty  Decimal @default(0) @map("distributed_qty") @db.Decimal(15, 4)

  consignment    Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  material       Material    @relation("consignment_items", fields: [materialId], references: [id])
  distributions  ConsignmentDistribution[]
  qualityChecks  QualityCheckItem[]         @relation("quality_checks")
  quantityAdjustments QuantityAdjustment[]
  inventoryTransactions InventoryTransaction[]

  @@index([consignmentId])
  @@index([materialId])
  @@map("consignment_items")
}

model ConsignmentDistribution {
  id                String    @id @default(uuid())
  consignmentId     String    @map("consignment_id")
  consignmentItemId String    @map("consignment_item_id")
  binId             String    @map("bin_id")
  quantity          Decimal   @db.Decimal(15, 4)
  distributedAt     DateTime  @map("distributed_at") @default(now())
  distributedById   String    @map("distributed_by_id")

  consignment        Consignment        @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  consignmentItem    ConsignmentItem    @relation(fields: [consignmentItemId], references: [id], onDelete: Cascade)
  bin                WarehouseBin       @relation(fields: [binId], references: [id])
  distributedBy      User               @relation(fields: [distributedById], references: [id])

  @@index([consignmentId])
  @@index([consignmentItemId])
  @@index([binId])
  @@map("consignment_distributions")
}

// ---------------------------------------------------------------------------
// 5B. Quality Approval Workflow
// ---------------------------------------------------------------------------

model QualityApproval {
  id                String                    @id @default(uuid())
  consignmentId     String                    @unique @map("consignment_id")
  status            QualityApprovalStatus     @default(PENDING)
  totalItems        Int                       @default(0) @map("total_items")
  passedItems       Int                       @default(0) @map("passed_items")
  failedItems       Int                       @default(0) @map("failed_items")
  startedAt         DateTime?                 @map("started_at")
  completedAt       DateTime?                 @map("completed_at")
  approvedAt        DateTime?                 @map("approved_at")
  rejectedAt        DateTime?                 @map("rejected_at")
  startedById       String?                   @map("started_by_id")
  approvedById      String?                   @map("approved_by_id")
  rejectionReason   String?                   @map("rejection_reason")
  notes             String?
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  consignment      Consignment              @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  startedBy        User?                    @relation("quality_approval_started", fields: [startedById], references: [id])
  approvedBy       User?                    @relation("quality_approval_approved", fields: [approvedById], references: [id])
  checkItems       QualityCheckItem[]
  
  @@index([status])
  @@index([consignmentId])
  @@map("quality_approvals")
}

model QualityCheckItem {
  id                      String                @id @default(uuid())
  qualityApprovalId       String                @map("quality_approval_id")
  consignmentItemId       String                @map("consignment_item_id")
  checkType               QualityCheckType      @map("check_type")
  status                  QualityApprovalStatus @default(PENDING)
  result                  String?               // "PASS" | "FAIL"
  remarks                 String?
  checkedAt               DateTime?             @map("checked_at")
  checkedById             String?               @map("checked_by_id")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  qualityApproval   QualityApproval  @relation(fields: [qualityApprovalId], references: [id], onDelete: Cascade)
  consignmentItem   ConsignmentItem  @relation("quality_checks", fields: [consignmentItemId], references: [id], onDelete: Cascade)
  checkedBy         User?            @relation("quality_check_performed", fields: [checkedById], references: [id])
  attachments       QualityCheckAttachment[]

  @@index([qualityApprovalId])
  @@index([consignmentItemId])
  @@index([status])
  @@map("quality_check_items")
}

/// Proof of a quality check (photo, certificate, lab report, ...). One check
/// item may carry several attachments. Files live in Supabase Storage; only the
/// object path is stored here, and signed URLs are minted on read.
model QualityCheckAttachment {
  id                 String   @id @default(uuid())
  qualityCheckItemId String   @map("quality_check_item_id")
  consignmentId      String   @map("consignment_id")
  fileName           String   @map("file_name")
  storagePath        String   @map("storage_path")
  mimeType           String?  @map("mime_type")
  fileSize           Int?     @map("file_size")
  kind               String? // PHOTO | COA | LAB_REPORT | DOCUMENT
  uploadedById       String   @map("uploaded_by_id")
  createdAt          DateTime @default(now()) @map("created_at")

  qualityCheckItem QualityCheckItem @relation(fields: [qualityCheckItemId], references: [id], onDelete: Cascade)
  consignment      Consignment     @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  uploadedBy       User            @relation(fields: [uploadedById], references: [id])

  @@index([qualityCheckItemId])
  @@index([consignmentId])
  @@map("quality_check_attachments")
}

/// QC-proposed change to a consignment ingredient's quantity, approved by the
/// Head of QC. Approval makes the new quantity authoritative and posts only the
/// delta not already reflected in the inventory ledger.
model QuantityAdjustment {
  id                     String                   @id @default(uuid())
  consignmentId          String                   @map("consignment_id")
  consignmentItemId      String                   @map("consignment_item_id")
  materialId             String                   @map("material_id")
  oldQuantity            Decimal                  @map("old_quantity") @db.Decimal(15, 4)
  newQuantity            Decimal                  @map("new_quantity") @db.Decimal(15, 4)
  difference             Decimal                  @db.Decimal(15, 4)
  reasonCode             String?                  @map("reason_code") // SHORTAGE | DAMAGE | OVERAGE | QUALITY_REJECT | RECOUNT
  reason                 String?
  status                 QuantityAdjustmentStatus @default(PENDING)
  requestedById          String                   @map("requested_by_id")
  requestedAt            DateTime                 @default(now()) @map("requested_at")
  approvedById           String?                  @map("approved_by_id")
  decidedAt              DateTime?                @map("decided_at")
  rejectionReason        String?                  @map("rejection_reason")
  appliedAt              DateTime?                @map("applied_at")
  inventoryTransactionId String?                  @map("inventory_transaction_id")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  consignment     Consignment     @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  consignmentItem ConsignmentItem @relation(fields: [consignmentItemId], references: [id], onDelete: Cascade)
  material        Material        @relation(fields: [materialId], references: [id])
  requestedBy     User            @relation("qty_adj_requested", fields: [requestedById], references: [id])
  approvedBy      User?           @relation("qty_adj_approved", fields: [approvedById], references: [id])

  @@index([consignmentId])
  @@index([consignmentItemId])
  @@index([status])
  @@index([requestedById])
  @@map("quantity_adjustments")
}

// ---------------------------------------------------------------------------
// 6. QA
// ---------------------------------------------------------------------------

model InspectionRecord {
  id             String           @id @default(uuid())
  inspectionType String           @map("inspection_type") // GRN | FINISHED_BATCH
  materialId     String           @map("material_id")
  batchLotId     String?          @map("batch_lot_id")
  referenceId    String?          @map("reference_id") // GRN or Production Order
  result         InspectionResult @default(PENDING)
  notes          String?
  inspectedById  String?          @map("inspected_by_id")
  inspectedAt    DateTime?        @map("inspected_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  material  Material  @relation(fields: [materialId], references: [id])
  batchLot  BatchLot? @relation(fields: [batchLotId], references: [id])
  inspector User?     @relation(fields: [inspectedById], references: [id])

  @@map("inspection_records")
}

// ---------------------------------------------------------------------------
// 7. User Activity Tracking
// ---------------------------------------------------------------------------

model UserActivity {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  activityType  String   @map("activity_type") // PAGE_VISIT, CREATE, UPDATE, DELETE, APPROVE, REJECT, TRANSFER, ADJUST
  module        String   // inventory, procurement, production, qa, audit, admin
  description   String?
  entityType    String?  @map("entity_type") // Material, Requisition, PurchaseOrder, etc.
  entityId      String?  @map("entity_id")
  details       Json?    // Additional context (before/after values, IP, user agent, etc.)
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([activityType, createdAt])
  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@map("user_activities")
}

// ---------------------------------------------------------------------------
// 8. Production Supervisor Workflow
// ---------------------------------------------------------------------------

model BatchMachineAllocation {
  id                    String    @id @default(uuid())
  productionPlanItemId  String    @map("production_plan_item_id")
  productionOrderId     String    @map("production_order_id")
  machineId             String    @map("machine_id")
  scheduledStartTime    DateTime? @map("scheduled_start_time")
  scheduledEndTime      DateTime? @map("scheduled_end_time")
  actualStartTime       DateTime? @map("actual_start_time")
  actualEndTime         DateTime? @map("actual_end_time")
  batchNumber           String?   @map("batch_number")
  status                String    @default("ALLOCATED") // ALLOCATED, SCHEDULED, IN_PROGRESS, COMPLETED
  supervisorId          String    @map("supervisor_id")
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  planItem          ProductionPlanItem @relation(fields: [productionPlanItemId], references: [id], onDelete: Cascade)
  productionOrder   ProductionOrder    @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  supervisor        User               @relation(fields: [supervisorId], references: [id])

  @@index([productionPlanItemId, machineId])
  @@index([supervisorId, createdAt])
  @@index([status])
  @@map("batch_machine_allocations")
}

model DailyProductionReconciliation {
  id                    String    @id @default(uuid())
  productionPlanId      String    @map("production_plan_id")
  reconciliationDate    DateTime  @map("reconciliation_date")
  supervisorId          String    @map("supervisor_id")
  plannedItemCount      Int       @map("planned_item_count")
  plannedTotalQuantity  Decimal   @map("planned_total_quantity") @db.Decimal(15, 4)
  actualItemCount       Int       @map("actual_item_count")
  actualTotalQuantity   Decimal   @map("actual_total_quantity") @db.Decimal(15, 4)
  quantityVariance      Decimal   @map("quantity_variance") @db.Decimal(15, 4)
  variancePercentage    Decimal   @map("variance_percentage") @db.Decimal(5, 2)
  discrepancyNotes      String?   @map("discrepancy_notes")
  status                String    @default("PENDING") // PENDING, VERIFIED, FLAGGED
  verifiedAt            DateTime? @map("verified_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  supervisor     User           @relation(fields: [supervisorId], references: [id])

  @@index([productionPlanId, reconciliationDate])
  @@index([supervisorId, createdAt])
  @@index([status])
  @@map("daily_production_reconciliations")
}

// ---------------------------------------------------------------------------
// 7. Cost Management & Audit
// ---------------------------------------------------------------------------

model CostAudit {
  id             String            @id @default(uuid())
  entityType     String            @map("entity_type") // Material, PurchaseOrderItem, BomIngredient, ProductionOrder, GoodsReceiptItem
  entityId       String            @map("entity_id")
  fieldName      String            @map("field_name") // unitCost, standardCost, estimatedCost, actualCost
  oldValue       Decimal?          @map("old_value") @db.Decimal(15, 4)
  newValue       Decimal           @map("new_value") @db.Decimal(15, 4)
  reason         String?           // Why the cost was changed
  changeType     String            @map("change_type") // MANUAL, APPROVED, BULK_UPDATE
  status         CostChangeStatus  @default(PENDING)
  changedById    String            @map("changed_by_id")
  approvedById   String?           @map("approved_by_id")
  approvedAt     DateTime?         @map("approved_at")
  rejectionReason String?          @map("rejection_reason")
  changedAt      DateTime          @default(now()) @map("changed_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  changedBy  User  @relation("cost_changed_by", fields: [changedById], references: [id])
  approvedBy User? @relation("cost_approved_by", fields: [approvedById], references: [id])

  @@index([entityType, entityId])
  @@index([changedById, changedAt])
  @@index([status, changedAt])
  @@map("cost_audits")
}

// ---------------------------------------------------------------------------
// 8. Notifications / Alerts
// ---------------------------------------------------------------------------

model Notification {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  title             String
  body              String?
  type              String // EXPIRY | LOW_STOCK | APPROVAL | SYSTEM
  notificationType  String   @default("SYSTEM") @map("notification_type") // LOW_STOCK_ALERT, APPROVAL_PENDING, SYSTEM, EXPIRY
  referenceId       String?  @map("reference_id") // Material ID for low-stock alerts, GRN ID for approvals, etc.
  isRead            Boolean  @default(false) @map("is_read")
  isActionable      Boolean  @default(false) @map("is_actionable") // True if user can take action (e.g., create requisition)
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, notificationType, isRead])
  @@index([createdAt])
  @@map("notifications")
}
